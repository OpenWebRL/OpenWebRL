# Repository and runtime paths.
export SLIME_REPO_ROOT="<absolute-path-to-this-repo>"
export SLIME_MODEL_ROOT="<path-to-model-checkpoints>"
export SLIME_SAVE_ROOT="<path-for-training-outputs>"
export SLIME_OUTPUT_ROOT="<path-for-evaluation-outputs>"
export PYTHONPATH="${SLIME_REPO_ROOT}:<path-to-Megatron-LM>"

# Browser environment mode: sandbox, local_process, or remote.
export SLIME_BROWSER_ENV_MODE="sandbox"
export BROWSER_SANDBOX_IMAGE="<your-registry>/browser-env:latest"
export SANDBOX_ORCHESTRATOR_URL=""
export SANDBOX_API_KEY=""
export BROWSER_ENV_SERVER_URL=""

# Judge / reward backend.
export JUDGE_API_MODE="token"
export JUDGE_MODEL="gpt-4.1"
export JUDGE_API_BASE=""
export JUDGE_API_KEY=""
export OPENAI_API_KEY=""
export OPENAI_API_BASE=""
export AZURE_RESOURCE_NAME=""
export AZURE_API_VERSION="2025-02-01-preview"

# Optional experiment tracking.
export WANDB_API_KEY=""
export WANDB_ENTITY=""
