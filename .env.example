# ==============================================================================
# OpenWebRL environment configuration.
#
# Copy to `.env`, fill in the values for your setup, then `source .env` in every
# shell that runs training or evaluation. `.env` is gitignored — never commit
# real credentials.
# ==============================================================================

# --- Repository & runtime paths ----------------------------------------------
# Keep large model/checkpoint/output dirs on a big volume, not the repo/root fs.
export SLIME_REPO_ROOT="<absolute-path-to-this-repo>"      # this repository
export SLIME_MODEL_ROOT="<path-to-model-checkpoints>"      # pretrained + converted checkpoints
export SLIME_SAVE_ROOT="<path-for-training-outputs>"       # RL checkpoints + logs
export SLIME_OUTPUT_ROOT="<path-for-evaluation-outputs>"   # eval results + debug traces
# PYTHONPATH must include this repo and your Megatron-LM checkout.
export PYTHONPATH="${SLIME_REPO_ROOT}:<path-to-Megatron-LM>"

# Hugging Face token — needed to download gated base models (e.g. Qwen3-VL).
export HF_TOKEN=""

# --- Browser environment mode ------------------------------------------------
# One of: sandbox | local_process | browser-use  (see openwebrl/env/config.yaml).
export SLIME_BROWSER_ENV_MODE="sandbox"

# sandbox mode: isolated browser pods via the Orchard sandbox orchestrator. More details at https://github.com/microsoft/Orchard.
export SANDBOX_ORCHESTRATOR_URL=""                                 # orchestrator base URL
export SANDBOX_API_KEY=""                                          # orchestrator API key (if required)
export BROWSER_SANDBOX_IMAGE="<your-registry>/browser-env:latest"  # see instructions in README.md for building/pushing the image

# remote / local_process modes: URL of a pre-started env_server (remote mode).
export BROWSER_ENV_SERVER_URL=""

# browser-use mode: remote browser at https://cloud.browser-use.com.
export BROWSER_USE_API_KEY=""

# --- Judge / reward backend (LLM-as-a-judge) ---------------------------------
# JUDGE_MODEL is the judge model / Azure deployment name (used in every mode).
# JUDGE_API_MODE selects how the client authenticates
# (see _get_openai_client in openwebrl/reward_browser.py):
#   token    -> Azure AD token : AZURE_RESOURCE_NAME + AZURE_TOKEN_PATH (+ AZURE_API_VERSION)
#   api_key  -> Azure OpenAI key: OPENAI_API_KEY + OPENAI_API_BASE (+ OPENAI_API_VERSION)
#   served   -> self-hosted OpenAI-compatible endpoint: JUDGE_API_BASE (+ optional JUDGE_API_KEY)
export JUDGE_API_MODE="api_key"
export JUDGE_MODEL="gpt-4.1"

# token mode → endpoint is built as https://<AZURE_RESOURCE_NAME>.openai.azure.com/
export AZURE_RESOURCE_NAME=""
export AZURE_TOKEN_PATH=""                                 # file holding a (periodically refreshed) Azure AD token
export AZURE_API_VERSION="2025-02-01-preview"

# api_key mode
export OPENAI_API_KEY=""
export OPENAI_API_BASE=""
export OPENAI_API_VERSION="2025-04-01-preview"

# served mode (self-hosted judge)
export JUDGE_API_BASE=""                                   # e.g. http://host:port/v1
export JUDGE_API_KEY=""                                    # optional; falls back to OPENAI_API_KEY, else "EMPTY"

# --- Experiment tracking (optional) ------------------------------------------
export WANDB_API_KEY=""
export WANDB_ENTITY=""
